# Secrets and per-server config — never committed. Written by install.sh on each server.
.env
*.env
.install-state

# install.sh's final summary (DNS records, MCP server URLs + bearer tokens) saved for later
# reference — contains real secrets (same tokens as ~/mcp-secrets/hub.env), chmod 600'd by
# install.sh itself, regenerated fresh on every run. Never commit this.
install-summary.txt

# Host-specific absolute paths to a manually-obtained TLS cert (obtain-manual-tls-cert.sh) —
# empty by default (see edge-proxy/Caddyfile), populated per-server, never shared.
edge-proxy/tls-override.conf

# Generated per-server TLS material (none expected here, but matches mcp-hub's own convention)
my-mcp-tools/mcp-hub/proxy/certs/

# OS cruft
.DS_Store
**/.DS_Store

# Claude Code local settings (per-machine, not shared project config)
**/.claude/settings.local.json

# Node / Next.js (client-chat-ui, agent-dashboard)
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# Python (agent-backend, mcp-hub's custom MCP servers)
__pycache__/
*.pyc
venv/
.venv/
