{
    email {$ACME_EMAIL}
}

# Automatic HTTPS: Caddy issues and renews real Let's Encrypt certs on its own (HTTP-01) for
# each hostname below, as long as its DNS A record points at this server's PUBLIC IP and ports
# 80/443 are reachable from the public internet.
#
# For a server with outbound-only connectivity (no inbound 80/443 at all, so HTTP-01 can never
# work regardless of DNS) but full DNS control: run ./obtain-manual-tls-cert.sh (repo root) to
# get a real trusted wildcard cert via a manual DNS-01 challenge instead. Every site block below
# starts with `import tls-override.conf` — that file is empty by default (so this changes
# nothing until that script is run) and, once populated, injects a `tls <cert> <key>` directive
# that makes Caddy use that static real cert instead of attempting automatic HTTPS for that
# site at all. See LAB_GUIDE.md Appendix 1.3.
#
# There is no self-signed/internal-CA fallback — every server gets a real, publicly-trusted
# certificate one way or the other.

{$CHAT_SUBDOMAIN:chat}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

{$AGENT_SUBDOMAIN:agent}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:8000
}

{$DASHBOARD_SUBDOMAIN:dashboard}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    basicauth {
        {$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
    }
    reverse_proxy 127.0.0.1:3001
}

{$MEMORY_SUBDOMAIN:memory}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:8082
}

{$MEMAPI_SUBDOMAIN:memapi}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:8083
}

{$RAGUI_SUBDOMAIN:ragui}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    basicauth {
        {$MCP_UI_USER} {$MCP_UI_PASSWORD_HASH}
    }
    reverse_proxy 127.0.0.1:8084
}
