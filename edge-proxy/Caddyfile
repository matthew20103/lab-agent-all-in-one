{
    email {$ACME_EMAIL}
    {$CADDY_LOCAL_CERTS}
}

# Automatic HTTPS: by default (CADDY_LOCAL_CERTS unset, the line above resolves to blank and
# is ignored), Caddy issues and renews real Let's Encrypt certs on its own for each hostname
# below, as long as its DNS A record points at this server's PUBLIC IP and ports 80/443 are
# reachable from the public internet — no DNS provider credentials needed, unlike the
# acme-dns setup this replaces.
#
# If this server only has a private/internal IP (common for a test box), public ACME
# validation can never reach it — Let's Encrypt reports "no valid A records found" even
# though DNS resolves fine internally. install.sh sets CADDY_LOCAL_CERTS=local_certs for that
# case: the global `local_certs` option switches every site block below to Caddy's own
# internal CA at once, no per-site changes needed. Works immediately with no public
# reachability, but browsers will show a "not trusted" warning (expected for a
# self-signed-style cert) unless you import Caddy's root CA, and `curl` needs `-k`/`--insecure`.
# Switch back (re-run install.sh, answer the public-reachability prompt "yes") once this is
# actually reachable from the public internet.
#
# A third option, for a server with outbound-only connectivity (no inbound 80/443 at all, so
# HTTP-01 above can never work regardless of DNS) but full DNS control: run
# ./obtain-manual-tls-cert.sh (repo root) to get a real trusted wildcard cert via a manual
# DNS-01 challenge. Every site block below starts with `import tls-override.conf` — that file
# is empty by default (so this changes nothing until that script is run) and, once populated,
# injects a `tls <cert> <key>` directive that makes Caddy use that static real cert instead of
# either automatic method above. See LAB_GUIDE.md Appendix 1.3.

{$CHAT_SUBDOMAIN:chat}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

{$AGENT_SUBDOMAIN:agent}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:8000
}

{$DASHBOARD_SUBDOMAIN:dashboard}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    basicauth {
        {$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
    }
    reverse_proxy 127.0.0.1:3001
}

{$MEMORY_SUBDOMAIN:memory}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:8082
}

{$MEMAPI_SUBDOMAIN:memapi}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    reverse_proxy 127.0.0.1:8083
}

{$RAGUI_SUBDOMAIN:ragui}.{$BASE_DOMAIN} {
    import tls-override.conf
    log {
        output stdout
    }
    basicauth {
        {$MCP_UI_USER} {$MCP_UI_PASSWORD_HASH}
    }
    reverse_proxy 127.0.0.1:8084
}
