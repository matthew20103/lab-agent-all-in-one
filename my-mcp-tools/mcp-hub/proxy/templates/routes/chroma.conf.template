# Public: http://<UBUNTU_IP>:8080/chroma/mcp  ->  chroma-mcp:8000/mcp
#
# deploy.sh's smoke test finds this route's expected token name via the FIRST
# "MCP_TOKEN_[A-Z0-9_]+" match in this file (grep ... | head -n1) — keep ${MCP_TOKEN_CHROMA}
# as that first match. Don't mention any other MCP_TOKEN_* name above this line, even in a
# comment: the lab-direct explanation below is deliberately placed after it for that reason.
location /chroma/ {
    error_page 418 = @chroma_lab_direct;
    recursive_error_pages on;
    if ($http_authorization != "Bearer ${MCP_TOKEN_CHROMA}") {
        return 418;
    }
    set $upstream http://chroma-mcp:8000;
    rewrite ^/chroma/(.*)$ /$1 break;
    proxy_pass $upstream;
    include /etc/nginx/snippets/mcp-proxy.conf;
}

# Fallback: accepts the shared MCP_TOKEN_LAB_DIRECT token via the x-portkey-api-key header
# (a lab-only shortcut — agent-backend's MCP client always sends that header/value pair
# unconditionally to whatever mcp_gateway_url it's pointed at, so this lets candidates point
# it straight at mcp-hub for the "direct" lab task without any code changes). One shared
# token for every server here is intentionally weaker than the per-server token above — that
# contrast is the point of the lab. Implemented as a separate named location (reached only via
# the error_page above) rather than a second condition in the same location, since nginx's
# `if` is only unconditionally safe when it contains nothing but a single `return`.
location @chroma_lab_direct {
    if ($http_x_portkey_api_key != "${MCP_TOKEN_LAB_DIRECT}") {
        return 401;
    }
    set $upstream http://chroma-mcp:8000;
    rewrite ^/chroma/(.*)$ /$1 break;
    proxy_pass $upstream;
    include /etc/nginx/snippets/mcp-proxy.conf;
}
