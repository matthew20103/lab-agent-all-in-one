# Public: http://<UBUNTU_IP>:8080/chroma/mcp  ->  chroma-mcp:8000/mcp
location /chroma/ {
    if ($http_authorization != "Bearer ${MCP_TOKEN_CHROMA}") {
        return 401;
    }
    set $upstream http://chroma-mcp:8000;
    rewrite ^/chroma/(.*)$ /$1 break;
    proxy_pass $upstream;
    include /etc/nginx/snippets/mcp-proxy.conf;
}
