FROM python:3.12-slim

# 1. Set the working directory
WORKDIR /app

# 2. Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 3. Copy requirements FIRST to leverage Docker cache
COPY app/requirements.txt .

# 4. Install everything GLOBALLY
RUN pip install --upgrade pip
RUN pip install --no-cache-dir streamlit redis
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy the rest of the application
COPY app/ .

# 6. Set environment variable to ensure python finds its modules
ENV PYTHONPATH=/app

# 7. Start streamlit using the absolute path to the python binary
ENTRYPOINT ["python3", "-m", "streamlit", "run", "dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
